<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shatha Alawneh - Luxurious Login</title>
    <style>
        :root {
            --primary: #8b5cf6; /* البنفسجي الملكي الرئيسي */
            --primary-dark: #7c3aed;
            --bg-color: #0f172a; /* كحلي عميق قريب للأسود للفخامة */
            --glass-bg: rgba(255, 255, 255, 0.03); /* شفافية عالية جداً */
            --glass-border: rgba(255, 255, 255, 0.08);
            --text-main: #f8fafc;
            --text-dim: #94a3b8;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at center, #1e293b 0%, var(--bg-color) 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: var(--text-main);
            overflow: hidden;
        }

        /* خلفية فخمة بتأثير الـ Glow */
        body::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: var(--primary);
            border-radius: 50%;
            filter: blur(150px);
            opacity: 0.2;
            z-index: -1;
        }

        .login-box {
            background: var(--glass-bg);
            backdrop-filter: blur(20px); /* تأثير الضبابية الزجاجي القوي */
            -webkit-backdrop-filter: blur(20px);
            padding: 50px 40px;
            border-radius: 24px;
            border: 1px solid var(--glass-border);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            width: 380px;
            text-align: center;
            position: relative;
            transition: 0.3s;
        }

        .login-box:hover {
            border-color: rgba(139, 92, 246, 0.3);
            box-shadow: 0 20px 50px rgba(139, 92, 246, 0.2);
        }

        .icon-header {
            font-size: 3rem;
            color: var(--primary);
            margin-bottom: 20px;
            display: inline-block;
            filter: drop-shadow(0 0 10px var(--primary));
        }

        h2 {
            font-weight: 300;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 35px;
            font-size: 1.5rem;
        }

        .input-group {
            margin-bottom: 25px;
            position: relative;
        }

        .input-group input {
            width: 100%;
            padding: 15px 15px 15px 45px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--text-main);
            font-size: 1rem;
            outline: none;
            transition: 0.3s;
        }

        .input-group input:focus {
            border-color: var(--primary);
            background: rgba(0, 0, 0, 0.3);
            box-shadow: 0 0 10px rgba(139, 92, 246, 0.2);
        }

        .input-group input::placeholder {
            color: var(--text-dim);
            font-size: 0.9rem;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-dim);
            font-size: 1.1rem;
            transition: 0.3s;
        }

        .input-group input:focus + .input-icon {
            color: var(--primary);
        }

        .sign-in-btn {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 5px 15px rgba(139, 92, 246, 0.3);
        }

        .sign-in-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(139, 92, 246, 0.4);
        }

        .footer-credit {
            margin-top: 30px;
            font-size: 11px;
            color: var(--text-dim);
            opacity: 0.7;
            letter-spacing: 1px;
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

    <div class="login-box">
        <div class="icon-header">
            <i class="fas fa-fingerprint"></i> </div>
        <h2>Sign In</h2>
        
        <form>
            <div class="input-group">
                <input type="text" placeholder="Username or Email">
                <i class="fas fa-user input-icon"></i>
            </div>

            <div class="input-group">
                <input type="password" placeholder="Password">
                <i class="fas fa-lock input-icon"></i>
            </div>

            <button type="submit" class="sign-in-btn">Authenticate</button>
        </form>
        
        <div class="footer-credit">
            Task 05 | Authored by <b>Shatha Alawneh</b>
        </div>
    </div>

</body>
</html>
